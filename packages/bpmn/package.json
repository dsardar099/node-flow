{
  "name": "@node-flow-dev/bpmn",
  "version": "1.0.0",
  "private": true,
  "description": "BPMN 2.0 import: converts a structured process into a node-flow definition.",
  "license": "LicenseRef-node-flow-1.0",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!**/*.tsbuildinfo",
    "!**/*.spec.*",
    "!**/testing/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@node-flow-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "bpmn",
    "tags": [
      "scope:client",
      "type:tooling"
    ]
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "tslib": "^2.3.0"
  }
}
