{
  "name": "@node-flow-dev/cli",
  "version": "1.0.0",
  "private": true,
  "description": "nf — deploy, run, tail, test and migrate node-flow from the command line.",
  "license": "LicenseRef-node-flow-1.0",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!**/*.tsbuildinfo",
    "!**/*.spec.*",
    "!**/testing/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@node-flow-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bin": {
      "@node-flow-dev/source": "./src/bin.ts",
      "import": "./dist/bin.js",
      "default": "./dist/bin.js"
    }
  },
  "nx": {
    "name": "cli",
    "tags": [
      "scope:app",
      "type:tooling"
    ]
  },
  "dependencies": {
    "@node-flow-dev/core": "workspace:*",
    "@node-flow-dev/store": "workspace:*",
    "@node-flow-dev/testkit": "workspace:*",
    "tslib": "^2.3.0"
  },
  "bin": {
    "nf": "./dist/bin.js"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0"
  }
}
