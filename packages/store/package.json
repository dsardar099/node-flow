{
  "name": "@node-flow-dev/store",
  "version": "1.0.0",
  "description": "Repositories, migrations and the Postgres-backed queue. All SQL lives here.",
  "license": "LicenseRef-node-flow-1.0",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!**/*.tsbuildinfo",
    "!**/*.spec.*",
    "!**/testing/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@node-flow-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "store",
    "tags": [
      "scope:infra",
      "type:data"
    ]
  },
  "dependencies": {
    "@node-flow-dev/core": "workspace:*",
    "@node-flow-dev/engine": "workspace:*",
    "@node-flow-dev/tasks": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "croner": "^10.0.1",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/client-sqs": "^3.1133.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@testcontainers/redpanda": "^12.1.0",
    "@types/pg": "^8.23.1",
    "@types/validator": "^13.15.10",
    "amqplib": "^2.0.1",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "nats": "^2.29.3",
    "testcontainers": "^12.1.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/client-sqs": "^3.1133.0",
    "amqplib": "^2.0.1",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "nats": "^2.29.3"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "amqplib": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "kafkajs": {
      "optional": true
    },
    "nats": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsardar099/node-flow.git",
    "directory": "packages/store"
  },
  "homepage": "https://node-flow.dev",
  "bugs": {
    "url": "https://github.com/dsardar099/node-flow/issues"
  }
